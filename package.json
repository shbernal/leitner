{
  "name": "flashcards-tui",
  "version": "0.1.0",
  "description": "Terminal UI for reviewing markdown flashcards",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flashcards-tui": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "flashcards-tui-local": "env FLASHCARDS_TUI_CALLER_CWD=\"$INIT_CWD\" ./bin/flashcards-tui",
    "test": "vitest run",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
